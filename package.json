{
    "name": "vending-machine-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "prettier": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css}'",
        "check-types": "tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "schema": "source .env && rm -rf ./resources/ts/api && openapi2aspida -i ${APP_URL}/docs/api.json -o ./resources/ts/api",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "dependencies": {
        "@aspida/axios": "^1.14.0",
        "autoprefixer": "^10.4.20",
        "axios": "^1.19.0",
        "dayjs": "^1.11.13",
        "openapi2aspida": "^0.24.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.54.2",
        "react-router-dom": "^6.30.4",
        "swr": "^2.3.0",
        "tailwindcss": "^3.4.17",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.10.2",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react-swc": "^3.7.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^1.1.1",
        "lint-staged": "^15.5.2",
        "prettier": "^3.4.2",
        "sass": "^1.83.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2",
        "vite": "^5.4.21"
    },
    "volta": {
        "node": "v24.18.1"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
    }
}
