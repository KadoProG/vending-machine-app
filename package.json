{
    "name": "vending-machine-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "prettier": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css}'",
        "check-types": "tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "schema": "source .env && rm -rf ./resources/ts/api && openapi2aspida -i ${APP_URL}/docs/api.json -o ./resources/ts/api",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "dependencies": {
        "@aspida/axios": "^1.14.0",
        "autoprefixer": "^10.6.2",
        "axios": "^1.21.1",
        "dayjs": "^1.11.23",
        "openapi2aspida": "^0.24.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.92.0",
        "react-router-dom": "^7.18.5",
        "swr": "^2.5.1",
        "tailwindcss": "^3.4.17",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.2.1",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "sass": "^1.108.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8"
    },
    "overrides": {
        "eslint-plugin-react": {
            "eslint": "$eslint"
        }
    },
    "volta": {
        "node": "v24.18.1"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
    }
}
